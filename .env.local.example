NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. From Supabase: Project Settings -> API -> "service_role" key.
# Never expose this with a NEXT_PUBLIC_ prefix or commit it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret. Make up any phrase — this is what gates who can sign up.
# Share it only with people you want in the club.
INVITE_CODE=change-me-to-something-only-your-club-knows

# Optional: only needed for the "auto-generate discussion questions" feature.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required for book search (covers, ratings, synopses) on the current-read and
# want-to-read pages. Free — create one at https://console.cloud.google.com
# (enable the "Books API" for the project, then create an API key under
# Credentials). No billing needed at this usage level.
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
